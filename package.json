{
  "name": "v-browser",
  "version": "0.1.0",
  "private": true,
  "description": "V-Browser: A modular browser interaction bridge",
  "keywords": [
    "automation",
    "browser",
    "playwright",
    "vlang"
  ],
  "license": "MIT",
  "author": "V-Browser Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/whiter001/v-browser.git"
  },
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:fix": "oxfmt --write .",
    "build:extension": "cd packages/extension && pnpm install && pnpm run build",
    "build:server": "cd packages/server && v .",
    "dev:server": "cd packages/server && v run src/main.v",
    "clean": "rm -rf packages/extension/dist packages/server/v-browser.exe"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=8",
    "v": ">=0.5.1"
  }
}
