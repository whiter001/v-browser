{
  "name": "@v-browser/extension",
  "version": "0.0.1",
  "private": true,
  "description": "V-Browser Browser Extension",
  "homepage": "https://github.com/whiter001/v-browser",
  "license": "MIT",
  "author": {
    "name": "V-Browser Team"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whiter001/v-browser.git"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --project . && tsc --project tsconfig.ui.json && vite build && vite build --config vite.sw.config.mts",
    "zip": "pnpm run build && zip -r ../v-browser-extension.zip dist/ manifest.json icons/",
    "watch": "tsc --watch --project . & tsc --watch --project tsconfig.ui.json & vite build --watch & vite build --watch --config vite.sw.config.mts",
    "lint": "tsc --project .",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.315",
    "@types/node": "^25.4.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.0",
    "minimist": "^1.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.8.2",
    "vite": "^8.0.0",
    "vite-plugin-static-copy": "^3.1.1",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3"
}
