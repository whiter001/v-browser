# v-browser runtime configuration template
# Note: v-browser does not auto-load .env. For a better experience, use the global config file instead:
#   - Windows: C:\Users\<username>\.config\v-browser\config
#   - macOS/Linux: ~/.config/v-browser/config
# Copy this file to .env and adjust the values for your machine.

# Required for first-time connect unless the extension has already synced its id to ~/.v-browser/extension_id
V_BROWSER_EXTENSION_ID=your-extension-id

# Windows example: C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# macOS example: /Applications/Google Chrome.app
# Linux example: /usr/bin/google-chrome
V_BROWSER_BROWSER_APP=path-to-your-browser

# Optional: override the home directory used by v-browser to store token, logs and extension id.
# Leave empty to use the current user's home directory.
V_BROWSER_HOME=

# Optional: override default relay / IPC ports when running multiple instances.
V_BROWSER_RELAY_PORT=47978
V_BROWSER_IPC_PORT=47979
